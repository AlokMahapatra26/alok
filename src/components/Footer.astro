---
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-bottom">
      <div class="footer-meta">
        <p>&copy; {currentYear} Alok Mahapatra. Personal Journal & Stories.</p>
        <p class="meta-note">Minimal & Distraction-free</p>
      </div>

      <nav class="footer-nav" aria-label="Footer Navigation">
        <a href="/">Home</a>
        <a href="/stories">Stories</a>
        <a href="/diary">Diary</a>
        <a href="/logs">Logs & Recommendations</a>
        <a href="/wall">Wall</a>
        <a href="/tools">Tools</a>
        <a href="#top" class="back-top" title="Back to top">↑ Top</a>
      </nav>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    border-top: 1px solid var(--border-light);
    background-color: var(--bg-secondary);
    padding: 2.5rem 0;
    transition: background-color 0.25s ease, border-color 0.25s ease;
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.25rem;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .meta-note {
    font-size: 0.78rem;
    color: var(--text-faint);
    margin-top: 0.25rem;
  }

  .footer-nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .footer-nav a {
    color: var(--text-secondary);
    transition: color 0.15s ease;
  }

  .footer-nav a:hover {
    color: var(--text-primary);
  }

  .back-top {
    font-family: var(--font-mono);
    color: var(--accent-terra) !important;
  }

  @media (max-width: 640px) {
    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
    }
    .footer-nav {
      flex-wrap: wrap;
      gap: 1rem;
    }
  }
</style>
