    // ==================== RICH TEXT EDITORS SETUP ====================
    function setupRichTextEditor(options: {
      toolbarId: string;
      canvasId: string;
      markdownId: string;
      viewVisualId: string;
      viewMarkdownId: string;
      linkBtnId: string;
      photoBtnId: string;
      photoFileId: string;
      wordsDisplayId: string;
      readtimeDisplayId: string;
    }) {
      const toolbar = document.getElementById(options.toolbarId);
      const canvas = document.getElementById(options.canvasId) as HTMLElement;
      const markdownArea = document.getElementById(options.markdownId) as HTMLTextAreaElement;
      const btnVisual = document.getElementById(options.viewVisualId);
      const btnMarkdown = document.getElementById(options.viewMarkdownId);
      const linkBtn = document.getElementById(options.linkBtnId);
      const photoBtn = document.getElementById(options.photoBtnId);
      const photoFile = document.getElementById(options.photoFileId) as HTMLInputElement;
      const wordsEl = document.getElementById(options.wordsDisplayId);
      const readEl = document.getElementById(options.readtimeDisplayId);

      let currentView: 'visual' | 'markdown' = 'visual';

      // Update word count and reading time
      function updateMetrics() {
        const text = currentView === 'visual' ? (canvas?.innerText || '') : (markdownArea?.value || '');
        const words = text.trim() ? text.trim().split(/\s+/).length : 0;
        const readTime = Math.max(1, Math.ceil(words / 180));
        if (wordsEl) wordsEl.textContent = `${words} words`;
        if (readEl) readEl.textContent = `${readTime} min read`;
      }

      canvas?.addEventListener('input', updateMetrics);
      markdownArea?.addEventListener('input', updateMetrics);

      // View toggle (Visual vs Markdown)
      function setView(view: 'visual' | 'markdown') {
        if (view === currentView) return;
        currentView = view;
        if (view === 'markdown') {
          btnMarkdown?.classList.add('active');
          btnVisual?.classList.remove('active');
          // HTML -> Markdown
          const md = htmlToMarkdown(canvas.innerHTML);
          markdownArea.value = md;
          canvas.style.display = 'none';
          markdownArea.style.display = 'block';
          markdownArea.focus();
        } else {
          btnVisual?.classList.add('active');
          btnMarkdown?.classList.remove('active');
          // Markdown -> HTML
          const html = marked.parse(markdownArea.value) as string;
          canvas.innerHTML = html;
          markdownArea.style.display = 'none';
          canvas.style.display = 'block';
          canvas.focus();
        }
        updateMetrics();
      }

      btnVisual?.addEventListener('click', () => setView('visual'));
      btnMarkdown?.addEventListener('click', () => setView('markdown'));

      // Toolbar button handlers (prevent mousedown to preserve editor selection)
      toolbar?.querySelectorAll('.tb-btn').forEach(btn => {
        btn.addEventListener('mousedown', (e) => {
          e.preventDefault();
        });
      });

      // Standard formatting commands (bold, italic, underline, strike, lists, hr, undo, redo)
      toolbar?.querySelectorAll('[data-cmd]').forEach(btn => {
        btn.addEventListener('click', () => {
          if (currentView !== 'visual') setView('visual');
          canvas.focus();
          const cmd = (btn as HTMLElement).dataset.cmd;
          if (cmd) {
            document.execCommand(cmd, false);
            updateMetrics();
          }
        });
      });

      // Block formatting (h2, h3, p, blockquote, pre)
      toolbar?.querySelectorAll('[data-format]').forEach(btn => {
        btn.addEventListener('click', () => {
          if (currentView !== 'visual') setView('visual');
          canvas.focus();
          const tag = (btn as HTMLElement).dataset.format;
          if (tag) {
            document.execCommand('formatBlock', false, `<${tag}>`);
            updateMetrics();
          }
        });
      });

      // Link creation
      linkBtn?.addEventListener('click', () => {
        if (currentView !== 'visual') setView('visual');
        canvas.focus();
        const url = prompt('Enter link URL (e.g. https://...):');
        if (url && url.trim()) {
          document.execCommand('createLink', false, url.trim());
          updateMetrics();
        }
      });

      // Photo insertion
      photoBtn?.addEventListener('click', () => {
        photoFile?.click();
      });

      photoFile?.addEventListener('change', async () => {
        if (!photoFile.files || !photoFile.files[0]) return;
        const file = photoFile.files[0];
        try {
          const comp = await compressImageFile(file, 1400, 900, 0.82);
          const caption = prompt('Caption for this photo (optional):') || file.name.replace(/\.[^/.]+$/, '');
          if (currentView === 'visual') {
            canvas.focus();
            const figureHtml = `
              <figure class="rich-figure">
                <img src="${comp}" alt="${caption}" />
                ${caption && caption !== 'Photo' ? `<figcaption contenteditable="true">${caption}</figcaption>` : ''}
              </figure>
              <p><br></p>
            `;
            document.execCommand('insertHTML', false, figureHtml);
          } else {
            const mdSnippet = `\n\n![${caption}](${comp})\n\n`;
            const start = markdownArea.selectionStart;
            const end = markdownArea.selectionEnd;
            markdownArea.value = markdownArea.value.substring(0, start) + mdSnippet + markdownArea.value.substring(end);
          }
          updateMetrics();
        } catch (e) {}
        photoFile.value = '';
      });

      // Keyboard shortcuts
      canvas?.addEventListener('keydown', (e) => {
        if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'b') {
          e.preventDefault();
          document.execCommand('bold');
        }
        if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'i') {
          e.preventDefault();
          document.execCommand('italic');
        }
        if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'u') {
          e.preventDefault();
          document.execCommand('underline');
        }
        if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
          e.preventDefault();
          const url = prompt('Enter link URL:');
          if (url && url.trim()) document.execCommand('createLink', false, url.trim());
        }
      });

      return {
        getContentMarkdown: () => {
          if (currentView === 'visual') {
            return htmlToMarkdown(canvas.innerHTML);
          }
          return markdownArea.value.trim();
        },
        setContent: (rawMarkdown: string) => {
          markdownArea.value = rawMarkdown;
          canvas.innerHTML = marked.parse(rawMarkdown) as string;
          canvas.scrollTop = 0;
          markdownArea.scrollTop = 0;
          const wrapper = canvas.closest('.rich-editor-wrapper') as HTMLElement | null;
          if (wrapper) wrapper.scrollTop = 0;
          updateMetrics();
        },
        updateMetrics
      };
    }

    const diaryEditor = setupRichTextEditor({
      toolbarId: 'diary-toolbar',
      canvasId: 'diary-rich-canvas',
      markdownId: 'diary-raw-markdown',
      viewVisualId: 'diary-view-visual',
      viewMarkdownId: 'diary-view-markdown',
      linkBtnId: 'diary-insert-link-btn',
      photoBtnId: 'diary-insert-photo-btn',
      photoFileId: 'diary-inline-photo-file',
      wordsDisplayId: 'word-count-display',
      readtimeDisplayId: 'read-time-display'
    });

    const storyEditor = setupRichTextEditor({
      toolbarId: 'story-toolbar',
      canvasId: 'story-rich-canvas',
      markdownId: 'story-raw-markdown',
      viewVisualId: 'story-view-visual',
      viewMarkdownId: 'story-view-markdown',
      linkBtnId: 'story-insert-link-btn',
      photoBtnId: 'story-insert-photo-btn',
      photoFileId: 'story-inline-photo-file',
      wordsDisplayId: 'story-words-display',
