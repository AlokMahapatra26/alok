<script>
  import { 
    isSupabaseConfigured,
    supabase,
    createSupabaseDiaryEntry, 
    updateSupabaseDiaryEntry,
    createSupabaseStory, 
    updateSupabaseStory 
  } from '../lib/supabase';
  import { marked } from 'marked';

  // Configure marked for clean GFM parsing
  marked.setOptions({
    gfm: true,
    breaks: true
  });

  // Convert HTML from contenteditable into clean Markdown
  function htmlToMarkdown(html: string): string {
    const div = document.createElement('div');
    div.innerHTML = html;

    function walk(node: Node): string {
      if (node.nodeType === Node.TEXT_NODE) {
        return node.textContent || '';
      }
      if (node.nodeType !== Node.ELEMENT_NODE) return '';

      const el = node as HTMLElement;
      const tag = el.tagName.toLowerCase();
      const inner = Array.from(el.childNodes).map(walk).join('');

      switch (tag) {
        case 'h1':
          return `\n\n# ${inner.trim()}\n\n`;
        case 'h2':
          return `\n\n## ${inner.trim()}\n\n`;
        case 'h3':
          return `\n\n### ${inner.trim()}\n\n`;
        case 'h4':
          return `\n\n#### ${inner.trim()}\n\n`;
        case 'strong':
        case 'b':
          return inner.trim() ? `**${inner}**` : '';
        case 'em':
        case 'i':
          return inner.trim() ? `*${inner}*` : '';
        case 'u':
          return inner.trim() ? `<u>${inner}</u>` : '';
        case 's':
        case 'strike':
        case 'del':
          return inner.trim() ? `~~${inner}~~` : '';
        case 'code':
          return el.parentElement?.tagName.toLowerCase() === 'pre' ? inner : `\`${inner}\``;
        case 'pre':
          return `\n\n\`\`\`\n${inner.trim()}\n\`\`\`\n\n`;
        case 'blockquote':
          return `\n\n> ${inner.trim().replace(/\n/g, '\n> ')}\n\n`;
        case 'ul':
          return `\n\n${inner.trim()}\n\n`;
        case 'ol':
          return `\n\n${inner.trim()}\n\n`;
        case 'li': {
          const isOl = el.parentElement?.tagName.toLowerCase() === 'ol';
          const idx = el.parentElement ? Array.from(el.parentElement.children).indexOf(el) + 1 : 1;
          return `${isOl ? `${idx}.` : '-'} ${inner.trim()}\n`;
        }
        case 'a': {
          const href = el.getAttribute('href') || '';
          return `[${inner.trim()}](${href})`;
        }
        case 'figure': {
          const img = el.querySelector('img');
          const cap = el.querySelector('figcaption');
          if (img) {
            const src = img.getAttribute('src') || '';
            const alt = cap?.textContent?.trim() || img.getAttribute('alt') || 'Photo';
            return `\n\n![${alt}](${src})\n\n`;
          }
          return inner;
        }
        case 'img': {
          const src = el.getAttribute('src') || '';
          const alt = el.getAttribute('alt') || 'Photo';
          return `\n\n![${alt}](${src})\n\n`;
        }
        case 'figcaption':
          return '';
        case 'hr':
          return `\n\n---\n\n`;
        case 'br':
          return `\n`;
        case 'p':
        case 'div':
          return inner.trim() ? `\n\n${inner.trim()}\n\n` : '';
        default:
          return inner;
      }
    }

    const raw = walk(div);
    return raw.replace(/\n{3,}/g, '\n\n').trim();
  }

  // Image compression helper (WebP canvas)
  function compressImageFile(file: File, maxWidth = 1400, maxHeight = 900, quality = 0.82): Promise<string> {
    return new Promise((resolve, reject) => {
      const reader = new FileReader();
      reader.onerror = () => reject(new Error('Failed to read image file'));
      reader.onload = (e) => {
        const img = new Image();
        img.onerror = () => reject(new Error('Failed to load image'));
        img.onload = () => {
          let width = img.width;
          let height = img.height;
          if (width > maxWidth || height > maxHeight) {
            const ratio = Math.min(maxWidth / width, maxHeight / height);
            width = Math.round(width * ratio);
            height = Math.round(height * ratio);
          }
          const canvas = document.createElement('canvas');
          canvas.width = width;
          canvas.height = height;
          const ctx = canvas.getContext('2d');
          if (!ctx) {
            resolve(e.target?.result as string);
            return;
          }
          ctx.drawImage(img, 0, 0, width, height);
          try {
            const webp = canvas.toDataURL('image/webp', quality);
            resolve(webp);
          } catch (err) {
            resolve(canvas.toDataURL('image/jpeg', quality));
          }
        };
        img.src = e.target?.result as string;
      };
      reader.readAsDataURL(file);
    });
  }

  async function initDedicatedWriter() {
    const lockScreen = document.getElementById('author-desk-lock');
    const workspace = document.getElementById('author-workspace');
    const backBtn = document.getElementById('writer-back-btn');

    // Parse URL parameters
    const params = new URLSearchParams(window.location.search);
    const typeParam = params.get('type') || params.get('mode');
    const editSlug = params.get('slug');
    const editId = params.get('id');

    // 1. Auth Guard Check
    let hasAuth = document.documentElement.getAttribute('data-author-authenticated') === 'true';
    if (!hasAuth && isSupabaseConfigured()) {
      try {
        const { data: { session } } = await supabase.auth.getSession();
        if (session) {
          hasAuth = true;
          document.documentElement.setAttribute('data-author-authenticated', 'true');
        }
      } catch (e) {}
    }

    if (!hasAuth && isSupabaseConfigured()) {
      if (lockScreen) lockScreen.style.display = 'flex';
      if (workspace) workspace.style.display = 'none';
      return;
    } else {
      if (lockScreen) lockScreen.style.display = 'none';
      if (workspace) workspace.style.display = 'block';
    }

    const tabDiary = document.getElementById('tab-diary');
    const tabStory = document.getElementById('tab-story');
    const editTag = document.getElementById('composer-editing-tag');
    const diaryForm = document.getElementById('diary-writer-form') as HTMLFormElement;
    const storyForm = document.getElementById('story-writer-form') as HTMLFormElement;

    let editingDiaryId: string | null = null;
    let editingStoryId: string | null = null;
    let currentMode: 'diary' | 'story' = typeParam === 'story' ? 'story' : 'diary';

    // Navigation back & discard
    backBtn?.addEventListener('click', () => {
      if (editSlug) {
        window.location.href = currentMode === 'diary' ? `/diary-entry?slug=${encodeURIComponent(editSlug)}` : `/story?slug=${encodeURIComponent(editSlug)}`;
      } else {
        window.location.href = currentMode === 'diary' ? '/diary' : '/stories';
      }
    });

    document.querySelectorAll('.form-discard-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        if (confirm('Discard your unsaved changes and leave the writer?')) {
          if (editSlug) {
            window.location.href = currentMode === 'diary' ? `/diary-entry?slug=${encodeURIComponent(editSlug)}` : `/story?slug=${encodeURIComponent(editSlug)}`;
          } else {
            window.location.href = currentMode === 'diary' ? '/diary' : '/stories';
          }
        }
      });
    });

    // Tab switcher
    function switchMode(mode: 'diary' | 'story') {
      currentMode = mode;
      if (mode === 'diary') {
        tabDiary?.classList.add('active');
        tabDiary?.setAttribute('aria-selected', 'true');
        tabStory?.classList.remove('active');
        tabStory?.setAttribute('aria-selected', 'false');
        if (diaryForm) diaryForm.style.display = 'flex';
        if (storyForm) storyForm.style.display = 'none';
      } else {
        tabStory?.classList.add('active');
        tabStory?.setAttribute('aria-selected', 'true');
        tabDiary?.classList.remove('active');
        tabDiary?.setAttribute('aria-selected', 'false');
        if (storyForm) storyForm.style.display = 'flex';
        if (diaryForm) diaryForm.style.display = 'none';
      }
    }

    tabDiary?.addEventListener('click', () => switchMode('diary'));
    tabStory?.addEventListener('click', () => switchMode('story'));

    // ==================== COLLAPSIBLE METADATA PANELS ====================
    // Diary Collapsible
    const diaryCard = document.getElementById('diary-collapsible-card');
    const diaryToggle = document.getElementById('diary-collapsible-toggle');
    const diarySummary = document.getElementById('diary-summary-badge');
    const diaryToggleLabel = document.getElementById('diary-toggle-label');

    function updateDiaryBadge() {
      const moodVal = (document.getElementById('entry-mood') as HTMLSelectElement)?.value || 'Reflective|🌧️';
      const [moodName, moodEmoji] = moodVal.split('|');
      const timeVal = (document.getElementById('entry-time') as HTMLInputElement)?.value.trim() || 'Today';
      const locVal = (document.getElementById('entry-location') as HTMLInputElement)?.value.trim();
      const hasCover = Boolean((document.getElementById('diary-cover-url') as HTMLInputElement)?.value.trim());

      const parts = [`${moodEmoji} ${moodName}`, timeVal];
      if (locVal) parts.push(locVal);
      if (hasCover) parts.push('Cover Attached');
      if (diarySummary) diarySummary.textContent = parts.join(' • ');
    }

    diaryToggle?.addEventListener('click', () => {
      const isCollapsed = diaryCard?.classList.toggle('collapsed');
      if (diaryToggleLabel) diaryToggleLabel.textContent = isCollapsed ? 'Show Details' : 'Hide Details';
      diaryToggle?.setAttribute('aria-expanded', isCollapsed ? 'false' : 'true');
    });

    ['entry-mood', 'entry-time', 'entry-location', 'entry-weather'].forEach(id => {
      document.getElementById(id)?.addEventListener('input', updateDiaryBadge);
      document.getElementById(id)?.addEventListener('change', updateDiaryBadge);
    });

    // Story Collapsible
    const storyCard = document.getElementById('story-collapsible-card');
    const storyToggle = document.getElementById('story-collapsible-toggle');
    const storySummary = document.getElementById('story-summary-badge');
    const storyToggleLabel = document.getElementById('story-toggle-label');

    function updateStoryBadge() {
      const catVal = (document.getElementById('story-category') as HTMLSelectElement)?.value || 'Short Story';
      const subVal = (document.getElementById('story-subtitle') as HTMLInputElement)?.value.trim();
