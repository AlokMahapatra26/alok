    // ==================== LOAD EDIT DATA IF SPECIFIED ====================
    async function loadEditData() {
      if (typeParam === 'story') {
        switchMode('story');
      } else {
        switchMode('diary');
      }

      if (typeParam === 'diary' && (editSlug || editId)) {
        if (editTag) {
          editTag.textContent = 'Editing Journal Entry';
          editTag.style.display = 'inline-block';
        }
        const saveBtn = document.getElementById('diary-save-btn');
        if (saveBtn) {
          const span = saveBtn.querySelector('span');
          if (span) span.textContent = 'Update Entry';
        }

        let entry: any = null;
        if (isSupabaseConfigured()) {
          try {
            let q = supabase.from('diary_entries').select('*');
            if (editId) q = q.eq('id', editId);
            else if (editSlug) q = q.eq('slug', editSlug);
            const { data } = await q.single();
            if (data) entry = data;
          } catch (e) {}
        }
        if (!entry) {
          try {
            const list = JSON.parse(localStorage.getItem('custom_diary_entries') || '[]');
            entry = list.find((x: any) => x.id === editId || x.slug === editSlug);
          } catch (e) {}
        }

        if (entry) {
          editingDiaryId = entry.id;
          const titleInput = document.getElementById('entry-title') as HTMLInputElement;
          const moodSelect = document.getElementById('entry-mood') as HTMLSelectElement;
          const locInput = document.getElementById('entry-location') as HTMLInputElement;
          const weatherInput = document.getElementById('entry-weather') as HTMLInputElement;

          if (titleInput) titleInput.value = entry.title || '';
          if (timeIn) timeIn.value = entry.time_of_day || entry.timeOfDay || '';
          if (locInput) locInput.value = entry.location || '';
          if (weatherInput) weatherInput.value = entry.weather || '';

          if (moodSelect) {
            const moodName = entry.mood || 'Reflective';
            for (let i = 0; i < moodSelect.options.length; i++) {
              if (moodSelect.options[i].value.startsWith(moodName)) {
                moodSelect.selectedIndex = i;
                break;
              }
            }
          }

          let coverVal = entry.cover_image || entry.coverImage || '';
          let diaryContent = Array.isArray(entry.content) ? [...entry.content] : (typeof entry.content === 'string' ? [entry.content] : []);
          if (!coverVal && diaryContent.length > 0 && typeof diaryContent[0] === 'string' && diaryContent[0].startsWith('__COVER__:')) {
            coverVal = diaryContent[0].replace('__COVER__:', '').trim();
            diaryContent = diaryContent.slice(1);
          }
          diaryContent = diaryContent.filter((c: string) => typeof c === 'string' && !c.startsWith('__COVER__:'));

          if (diaryCoverUrlInput) {
            diaryCoverUrlInput.value = coverVal;
            updateDiaryThumbPreview(coverVal);
            if (coverVal && !coverVal.startsWith('data:')) {
              btnDiaryModeUrl?.click();
            } else if (coverVal) {
              btnDiaryModeUpload?.click();
            }
          }

          diaryEditor?.setContent(diaryContent.join('\n\n'));
          updateDiaryBadge();
          if (diaryCard && !diaryCard.classList.contains('collapsed')) {
            diaryCard.classList.add('collapsed');
            if (diaryToggleLabel) diaryToggleLabel.textContent = 'Show Details';
            diaryToggle?.setAttribute('aria-expanded', 'false');
          }
        }
      } else if (typeParam === 'story' && (editSlug || editId)) {
        if (editTag) {
          editTag.textContent = 'Editing Story';
          editTag.style.display = 'inline-block';
        }
        const saveBtn = document.getElementById('story-save-btn');
        if (saveBtn) {
          const span = saveBtn.querySelector('span');
          if (span) span.textContent = 'Update Story';
        }

        let story: any = null;
        if (isSupabaseConfigured()) {
          try {
            let q = supabase.from('stories').select('*');
            if (editId) q = q.eq('id', editId);
            else if (editSlug) q = q.eq('slug', editSlug);
            const { data } = await q.single();
            if (data) story = data;
          } catch (e) {}
        }
        if (!story) {
          try {
            const list = JSON.parse(localStorage.getItem('custom_stories') || '[]');
            story = list.find((x: any) => x.id === editId || x.slug === editSlug);
          } catch (e) {}
        }

        if (story) {
          editingStoryId = story.id;
          const titleInput = document.getElementById('story-title') as HTMLInputElement;
          const subInput = document.getElementById('story-subtitle') as HTMLInputElement;
          const catSelect = document.getElementById('story-category') as HTMLSelectElement;
          const excerptInput = document.getElementById('story-excerpt') as HTMLTextAreaElement;

          if (titleInput) titleInput.value = story.title || '';
          if (subInput) subInput.value = story.subtitle || '';
          if (catSelect && story.category) catSelect.value = story.category;
          if (excerptInput) excerptInput.value = story.excerpt || '';

          let storyCoverVal = story.cover_image || story.coverImage || '';
          let storyContent = Array.isArray(story.content) ? [...story.content] : (typeof story.content === 'string' ? [story.content] : []);
          if (!storyCoverVal && storyContent.length > 0 && typeof storyContent[0] === 'string' && storyContent[0].startsWith('__COVER__:')) {
            storyCoverVal = storyContent[0].replace('__COVER__:', '').trim();
            storyContent = storyContent.slice(1);
          }
          storyContent = storyContent.filter((c: string) => typeof c === 'string' && !c.startsWith('__COVER__:'));

          if (storyCoverUrlInput) {
            storyCoverUrlInput.value = storyCoverVal;
            updateStoryThumbPreview(storyCoverVal);
            if (storyCoverVal && !storyCoverVal.startsWith('data:')) {
              btnModeUrl?.click();
            } else if (storyCoverVal) {
              btnModeUpload?.click();
            }
          }

          storyEditor?.setContent(storyContent.join('\n\n'));
          updateStoryBadge();
          if (storyCard && !storyCard.classList.contains('collapsed')) {
            storyCard.classList.add('collapsed');
            if (storyToggleLabel) storyToggleLabel.textContent = 'Show Details';
            storyToggle?.setAttribute('aria-expanded', 'false');
          }
        }
      }
    }

    loadEditData();

    // ==================== SUBMIT HANDLERS ====================
    diaryForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const saveBtn = document.getElementById('diary-save-btn') as HTMLButtonElement;
      if (!saveBtn) return;

      const titleInput = document.getElementById('entry-title') as HTMLInputElement;
      const moodSelect = document.getElementById('entry-mood') as HTMLSelectElement;
      const locationInput = document.getElementById('entry-location') as HTMLInputElement;
      const weatherInput = document.getElementById('entry-weather') as HTMLInputElement;

      const title = titleInput.value.trim();
      const [moodName, moodEmoji] = (moodSelect?.value || 'Reflective|🌧️').split('|');
      const timeOfDay = timeIn?.value.trim() || new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
      const location = locationInput?.value.trim() || '';
      const weather = weatherInput?.value.trim() || '';
      const coverImage = diaryCoverUrlInput?.value.trim() || '';

      const rawMarkdown = diaryEditor?.getContentMarkdown() || '';
      const paragraphs = rawMarkdown.split(/\n\n+/).map(p => p.trim()).filter(Boolean);
      if (paragraphs.length === 0) {
        alert('Please write some content before saving.');
        return;
      }

      const words = rawMarkdown.trim().split(/\s+/).length;
      const readTime = `${Math.max(1, Math.ceil(words / 180))} min read`;

      saveBtn.disabled = true;
      saveBtn.textContent = 'Saving...';

      try {
        if (editingDiaryId) {
          // UPDATE
          if (isSupabaseConfigured()) {
            try {
              await updateSupabaseDiaryEntry(editingDiaryId, {
                title,
                content: paragraphs,
                cover_image: coverImage,
                mood: moodName,
                mood_emoji: moodEmoji,
                location,
                weather,
                time_of_day: timeOfDay,
                read_time: readTime
              });
            } catch (err) {
              console.warn('Supabase update fallback to local:', err);
              const stored = localStorage.getItem('custom_diary_entries');
              const list = stored ? JSON.parse(stored) : [];
              const idx = list.findIndex((x: any) => x.id === editingDiaryId);
              if (idx !== -1) {
                list[idx] = { ...list[idx], title, coverImage, cover_image: coverImage, content: paragraphs, mood: moodName, moodEmoji, location, weather, timeOfDay, readTime };
                localStorage.setItem('custom_diary_entries', JSON.stringify(list));
              }
            }
          }
          window.location.href = editSlug ? `/diary-entry?slug=${encodeURIComponent(editSlug)}` : '/diary';
        } else {
          // CREATE NEW
          let targetSlug = 'entry-' + Date.now();
          if (isSupabaseConfigured()) {
            try {
              const res = await createSupabaseDiaryEntry({
                title,
                content: paragraphs,
                cover_image: coverImage,
                mood: moodName,
                mood_emoji: moodEmoji,
                location,
                weather,
                time_of_day: timeOfDay,
                read_time: readTime
              });
              if (res?.slug) targetSlug = res.slug;
            } catch (err) {
              console.warn('Supabase create fallback to local:', err);
              const stored = localStorage.getItem('custom_diary_entries');
              const entries = stored ? JSON.parse(stored) : [];
              entries.unshift({
                id: 'diary-' + Date.now(),
                slug: targetSlug,
                title,
                coverImage,
                cover_image: coverImage,
                date: new Date().toLocaleDateString('en-US', { month: 'long', day: '2-digit', year: 'numeric' }),
                timeOfDay,
                location,
                weather,
                mood: moodName,
                moodEmoji,
                readTime,
                content: paragraphs,
                isCustom: true
              });
              localStorage.setItem('custom_diary_entries', JSON.stringify(entries));
            }
          }
          window.location.href = `/diary-entry?slug=${targetSlug}`;
        }
      } catch (err: any) {
        alert('Failed to save entry: ' + (err.message || err));
        saveBtn.disabled = false;
        saveBtn.textContent = 'Save to Journal';
      }
    });

    storyForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const saveBtn = document.getElementById('story-save-btn') as HTMLButtonElement;
      if (!saveBtn) return;

      const titleInput = document.getElementById('story-title') as HTMLInputElement;
      const subInput = document.getElementById('story-subtitle') as HTMLInputElement;
      const catSelect = document.getElementById('story-category') as HTMLSelectElement;
      const excerptInput = document.getElementById('story-excerpt') as HTMLTextAreaElement;

      const title = titleInput.value.trim();
      const subtitle = subInput?.value.trim() || '';
      const category = catSelect?.value || 'Short Story';
      const excerpt = excerptInput?.value.trim() || '';
      const coverImage = storyCoverUrlInput?.value.trim() || '';

      const rawMarkdown = storyEditor?.getContentMarkdown() || '';
      const paragraphs = rawMarkdown.split(/\n\n+/).map(p => p.trim()).filter(Boolean);
      if (paragraphs.length === 0) {
        alert('Please write some story content before publishing.');
        return;
      }

      const words = rawMarkdown.trim().split(/\s+/).length;
      const readTime = `${Math.max(1, Math.ceil(words / 180))} min read`;

      saveBtn.disabled = true;
      saveBtn.textContent = 'Publishing...';

      try {
        if (editingStoryId) {
          // UPDATE
          if (isSupabaseConfigured()) {
            try {
              await updateSupabaseStory(editingStoryId, {
                title,
                subtitle,
                category,
                excerpt,
                cover_image: coverImage,
                read_time: readTime,
                content: paragraphs
              });
            } catch (err) {
              console.warn('Supabase update fallback to local:', err);
              const stored = localStorage.getItem('custom_stories');
              const list = stored ? JSON.parse(stored) : [];
              const idx = list.findIndex((x: any) => x.id === editingStoryId);
              if (idx !== -1) {
                list[idx] = { ...list[idx], title, subtitle, category, excerpt, cover_image: coverImage, readTime, content: paragraphs };
                localStorage.setItem('custom_stories', JSON.stringify(list));
              }
            }
          }
          window.location.href = editSlug ? `/story?slug=${encodeURIComponent(editSlug)}` : '/stories';
        } else {
          // CREATE NEW
          let targetSlug = 'story-' + Date.now();
          if (isSupabaseConfigured()) {
            try {
              const res = await createSupabaseStory({
                title,
                subtitle,
                category,
                excerpt,
                cover_image: coverImage,
                read_time: readTime,
                content: paragraphs
              });
              if (res?.slug) targetSlug = res.slug;
            } catch (err) {
              console.warn('Supabase create fallback to local:', err);
              const stored = localStorage.getItem('custom_stories');
              const list = stored ? JSON.parse(stored) : [];
              list.unshift({
                id: 'story-' + Date.now(),
                slug: targetSlug,
                title,
                subtitle,
                category,
                excerpt,
                cover_image: coverImage,
                readTime,
                date: new Date().toLocaleDateString('en-US', { month: 'long', day: '2-digit', year: 'numeric' }),
                content: paragraphs,
                isCustom: true
              });
              localStorage.setItem('custom_stories', JSON.stringify(list));
            }
          }
          window.location.href = `/story?slug=${targetSlug}`;
        }
      } catch (err: any) {
        alert('Failed to publish story: ' + (err.message || err));
        saveBtn.disabled = false;
        saveBtn.textContent = 'Publish Story';
      }
    });
  }

  initDedicatedWriter();
  document.addEventListener('astro:after-swap', initDedicatedWriter);
</script>
