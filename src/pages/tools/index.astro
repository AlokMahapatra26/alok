---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Tools — Alok Mahapatra"
  description="Focused, lightweight interactive utilities and tools built by Alok Mahapatra."
  activePath="/tools"
>
  <div class="content-container tools-page">
    <!-- Header -->
    <header class="tools-header">
      <span class="header-kicker">Interactive Utilities</span>
      <h1 class="page-title">Tools</h1>
      <p class="page-subtitle">
        A directory of focused, lightweight utilities and experiments crafted for speed, minimal distraction, and utility.
      </p>
    </header>

    <!-- Tools Grid -->
    <div class="tools-grid">
      <a href="/tools/md-share" class="tool-card">
        <div class="tool-card-header">
          <div class="tool-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="16" y1="13" x2="8" y2="13"></line>
              <line x1="16" y1="17" x2="8" y2="17"></line>
              <polyline points="10 9 9 9 8 9"></polyline>
            </svg>
          </div>
          <span class="tool-badge">Live</span>
        </div>

        <h2 class="tool-title">Markdown Share & Viewer</h2>
        <p class="tool-desc">
          Paste or upload any markdown file, render publication-grade typography, and create instant shareable links.
        </p>

        <div class="tool-card-footer">
          <span class="tool-link-text">Launch Tool</span>
          <svg class="tool-link-arrow" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </div>
      </a>
    </div>
  </div>
</BaseLayout>

<style>
  .tools-page {
    padding-top: 3.5rem;
    padding-bottom: 5.5rem;
  }

  .tools-header {
    margin-bottom: 2.5rem;
    padding-bottom: 1.75rem;
    border-bottom: 1px solid var(--border-light);
  }

  .header-kicker {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 600;
    color: var(--accent-terra);
    display: block;
    margin-bottom: 0.5rem;
  }

  .page-title {
    font-size: 2.75rem;
    font-weight: 500;
    margin-bottom: 0.75rem;
    letter-spacing: -0.025em;
  }

  .page-subtitle {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    color: var(--text-secondary);
    max-width: 640px;
    line-height: 1.65;
  }

  /* Tools Grid & Card */
  .tools-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 340px));
    gap: 1.5rem;
  }

  .tool-card {
    display: flex;
    flex-direction: column;
    background-color: var(--bg-card);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    padding: 1.5rem;
    text-decoration: none;
    color: inherit;
    box-shadow: var(--card-shadow);
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .tool-card:hover {
    transform: translateY(-3px);
    border-color: var(--border-strong);
    box-shadow: var(--card-shadow-hover);
  }

  .tool-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.1rem;
  }

  .tool-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: var(--radius-sm);
    background-color: rgba(158, 86, 56, 0.1);
    color: var(--accent-terra);
  }

  .tool-badge {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.2rem 0.55rem;
    border-radius: 9999px;
    background-color: rgba(61, 97, 77, 0.12);
    color: var(--accent-sage);
    border: 1px solid rgba(61, 97, 77, 0.25);
  }

  .tool-title {
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0 0 0.5rem 0;
    line-height: 1.35;
    transition: color 0.15s ease;
  }

  .tool-card:hover .tool-title {
    color: var(--accent-terra);
  }

  .tool-desc {
    font-family: var(--font-serif);
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--text-secondary);
    margin: 0 0 1.25rem 0;
    flex-grow: 1;
  }

  .tool-card-footer {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--border-light);
    color: var(--accent-terra);
    font-size: 0.86rem;
    font-weight: 600;
  }

  .tool-link-arrow {
    transition: transform 0.15s ease;
  }

  .tool-card:hover .tool-link-arrow {
    transform: translateX(4px);
  }

  @media (max-width: 640px) {
    .tools-grid {
      grid-template-columns: 1fr;
    }
    
    .page-title {
      font-size: 2.2rem;
    }
  }
</style>
