---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { stories } from '../../data/stories';
---

<BaseLayout
  title="Stories & Prose — Alok Mahapatra"
  description="Stories, essays, and prose where readers can read and comment."
  activePath="/stories"
>
  <div class="container stories-page-container">
    <!-- Page Header -->
    <header class="page-header">
      <span class="header-kicker">Writing</span>
      <h1 class="page-title">Stories & Prose</h1>
      <p class="page-description">
        Stories, essays, and reflections. Readers are warmly welcomed to share comments beneath each piece.
      </p>

      <div class="controls-bar" id="stories-controls-bar" style="display: none;">
        <div class="category-tabs" id="category-tabs">
          <button type="button" class="filter-tab active" data-cat="All">All</button>
        </div>

        <div class="search-box">
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input 
            type="text" 
            id="story-search-input" 
            placeholder="Search stories..." 
            aria-label="Search stories"
          />
        </div>
      </div>
    </header>

    <div class="stories-feed" id="stories-feed" data-static-stories={JSON.stringify(stories)}>
      <!-- Rendered dynamically -->
    </div>

    <div id="no-stories-found" class="no-results" style="display: none;">
      <p>No stories found matching your filter or query.</p>
      <button type="button" id="reset-filter-btn" class="reset-btn">Reset Filters</button>
    </div>
  </div>
</BaseLayout>

<style>
  .stories-page-container {
    padding-top: 3.5rem;
    padding-bottom: 5rem;
  }

  .page-header {
    margin-bottom: 3.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border-light);
  }

  .header-kicker {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 600;
    color: var(--accent-terra);
    display: block;
    margin-bottom: 0.5rem;
  }

  .page-title {
    font-size: 2.5rem;
    font-weight: 500;
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
  }

  .page-description {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    color: var(--text-secondary);
    max-width: 650px;
    line-height: 1.65;
    margin-bottom: 2.25rem;
  }

  .controls-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .category-tabs {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .filter-tab {
    font-size: 0.85rem;
    font-weight: 500;
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-sm);
    color: var(--text-secondary);
    background-color: var(--bg-subtle);
    border: 1px solid var(--border-light);
    transition: all 0.15s ease;
  }

  .filter-tab:hover {
    color: var(--text-primary);
    border-color: var(--border-strong);
  }

  .filter-tab.active {
    color: var(--bg-primary);
    background-color: var(--text-primary);
    border-color: var(--text-primary);
  }

  .search-box {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    background-color: var(--bg-card);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-sm);
    padding: 0.45rem 0.85rem;
    min-width: 260px;
    color: var(--text-muted);
  }

  .search-box input {
    border: none;
    background: transparent;
    font-size: 0.88rem;
    color: var(--text-primary);
    outline: none;
    width: 100%;
  }

  .search-box:focus-within {
    border-color: var(--accent-terra);
  }

  .stories-feed {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem 1.25rem;
  }

  @media (max-width: 1024px) {
    .stories-feed {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 768px) {
    .stories-feed {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem 0.75rem;
    }
  }

  :global(.story-mini-card) {
    display: flex;
    flex-direction: column;
    background-color: var(--bg-card);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  :global(.story-mini-card:hover) {
    border-color: var(--border-strong);
    box-shadow: var(--card-shadow);
    transform: translateY(-2px);
  }

  :global(.story-mini-cover-wrap) {
    position: relative;
    width: 100%;
    aspect-ratio: 2 / 3;
    background-color: var(--bg-subtle);
    overflow: hidden;
  }

  :global(.story-mini-cover-link) {
    display: block;
    width: 100%;
    height: 100%;
  }

  :global(.story-mini-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.35s ease;
  }

  :global(.story-mini-card:hover .story-mini-img) {
    transform: scale(1.05);
  }

  :global(.story-mini-fallback) {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.6rem;
    background: linear-gradient(135deg, var(--bg-subtle), var(--bg-secondary));
    color: var(--text-muted);
  }

  :global(.story-mini-actions) {
    position: absolute;
    top: 0.35rem;
    right: 0.35rem;
    display: inline-flex;
    gap: 0.25rem;
    z-index: 2;
  }

  :global(.mini-card-btn) {
    width: 22px;
    height: 22px;
    border-radius: var(--radius-sm);
    background-color: rgba(28, 27, 25, 0.7);
    backdrop-filter: blur(4px);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    cursor: pointer;
    transition: background-color 0.15s ease;
  }

  :global(.mini-card-btn:hover) {
    background-color: var(--accent-terra);
  }

  :global(.mini-card-btn.delete-story-action:hover) {
    background-color: #e53e3e;
  }

  :global(.story-mini-body) {
    padding: 0.75rem 0.85rem 0.85rem;
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 0.2rem;
  }

  :global(.story-mini-title) {
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1.3;
    font-family: var(--font-serif);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  :global(.story-mini-title a) {
    color: var(--text-primary);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  :global(.story-mini-title a:hover) {
    color: var(--accent-terra);
  }

  :global(.story-mini-meta-line) {
    font-size: 0.75rem;
    color: var(--text-muted);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.4rem;
  }

  :global(.story-type-badge) {
    position: absolute;
    top: 0.6rem;
    left: 0.6rem;
    font-size: 0.68rem;
    font-weight: 600;
    padding: 0.2rem 0.5rem;
    border-radius: 9999px;
    background: rgba(18, 19, 20, 0.75);
    color: #fff;
    backdrop-filter: blur(4px);
    pointer-events: none;
  }

  .no-results {
    text-align: center;
    padding: 4rem 1rem;
    color: var(--text-muted);
    font-family: var(--font-serif);
    font-size: 1.1rem;
  }

  .reset-btn {
    margin-top: 1rem;
    padding: 0.5rem 1rem;
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-sm);
    color: var(--text-primary);
    font-size: 0.85rem;
  }

  @media (max-width: 640px) {
    .controls-bar {
      flex-direction: column;
      align-items: stretch;
    }
    .search-box {
      min-width: unset;
      width: 100%;
    }
    .page-title {
      font-size: 2.1rem;
    }
  }
</style>

<script>
  import { isSupabaseConfigured, getSupabaseStories, deleteSupabaseStory } from '../../lib/supabase';

  async function loadAndRenderStories() {
    const feed = document.getElementById('stories-feed');
    const controls = document.getElementById('stories-controls-bar');
    const categoryTabsContainer = document.getElementById('category-tabs');
    const searchInput = document.getElementById('story-search-input') as HTMLInputElement;
    const noResults = document.getElementById('no-stories-found');

    if (!feed) return;

    let dbStories = [];
    if (isSupabaseConfigured()) {
      try {
        const rows = await getSupabaseStories();
        dbStories = rows.map((r: any) => ({
          id: r.id,
          slug: r.slug,
          title: r.title,
          subtitle: r.subtitle || '',
          excerpt: r.excerpt || '',
          category: r.category || 'Story',
          readTime: r.read_time || '5 min',
          date: new Date(r.created_at).toLocaleDateString('en-US', { month: 'long', day: '2-digit', year: 'numeric' }),
          content: r.content || [],
          cover_image: r.cover_image || '',
          commentsCount: 0,
          isCustom: false
        }));
      } catch (e) {
        console.error('Error fetching Supabase stories:', e);
      }
    }

    let localCustomStories = [];
    try {
      const stored = localStorage.getItem('custom_stories');
      if (stored) {
        localCustomStories = JSON.parse(stored).map((s: any) => ({
          ...s,
          cover_image: s.cover_image || s.coverImage || '',
          isCustom: true
        }));
      }
    } catch (e) {}

    const allStories = [...dbStories, ...localCustomStories];

    if (allStories.length === 0) {
      if (controls) controls.style.display = 'none';
      feed.innerHTML = `
        <div style="padding: 4rem 1.5rem; text-align: center; border: 1px dashed var(--border-light); border-radius: var(--radius-md); background-color: var(--bg-card);">
          <p style="font-family: var(--font-serif); font-size: 1.25rem; color: var(--text-primary); margin-bottom: 0.5rem;">No stories published yet.</p>
          <p style="font-size: 0.95rem; color: var(--text-muted); margin: 0;">Stories published from the Author Desk will appear here for readers.</p>
        </div>
      `;
      return;
    }

    if (controls) controls.style.display = 'flex';

    // Populate category tabs
    const categories = ['All', ...Array.from(new Set(allStories.map((s: any) => s.category)))];
    if (categoryTabsContainer) {
      categoryTabsContainer.innerHTML = categories.map((cat, idx) => `
        <button type="button" class="filter-tab ${idx === 0 ? 'active' : ''}" data-cat="${escapeHtml(cat)}">
          ${escapeHtml(cat)}
        </button>
      `).join('');
    }

    let currentCategory = 'All';
    let searchQuery = '';

    function filterAndRender() {
      const filtered = allStories.filter((s: any) => {
        const matchesCat = currentCategory === 'All' || s.category.toLowerCase() === currentCategory.toLowerCase();
        const matchesQuery = !searchQuery || 
          s.title.toLowerCase().includes(searchQuery) || 
          (s.excerpt || '').toLowerCase().includes(searchQuery);

        return matchesCat && matchesQuery;
      });

      if (filtered.length === 0) {
        feed.innerHTML = '';
        if (noResults) noResults.style.display = 'block';
        return;
      }

      if (noResults) noResults.style.display = 'none';

      feed.innerHTML = filtered.map((story: any) => `
        <article class="story-mini-card animate-fade-in">
          <div class="story-mini-cover-wrap">
            <a href="/story?slug=${story.slug}" class="story-mini-cover-link" aria-label="${escapeHtml(story.title)}">
              ${story.cover_image ? `
                <img src="${escapeHtml(story.cover_image)}" alt="${escapeHtml(story.title)}" class="story-mini-img" loading="lazy" />
              ` : `
                <div class="story-mini-fallback">
                  <span>📖</span>
                </div>
              `}
            </a>
            ${story.category ? `<span class="story-type-badge">📖 ${escapeHtml(story.category)}</span>` : ''}

            <div class="story-mini-actions" data-author-only>
              <button type="button" class="mini-card-btn edit-story-action" data-story-id="${story.id}" title="Edit story">
                <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 20h9"></path>
                  <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
                </svg>
              </button>
              <button type="button" class="mini-card-btn delete-story-action" data-story-id="${story.id}" data-story-title="${escapeHtml(story.title)}" data-is-custom="${story.isCustom ? 'true' : 'false'}" title="Delete story">
                <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="3 6 5 6 21 6"></polyline>
                  <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                </svg>
              </button>
            </div>
          </div>

          <div class="story-mini-body">
            <h3 class="story-mini-title">
              <a href="/story?slug=${story.slug}">${escapeHtml(story.title)}</a>
            </h3>
            <div class="story-mini-meta-line">
              <span>${escapeHtml(story.date || '')}</span>
              ${story.readTime ? `<span>${escapeHtml(story.readTime)}</span>` : ''}
            </div>
          </div>
        </article>
      `).join('');

      // Wire edit actions
      feed.querySelectorAll('.edit-story-action').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const target = e.currentTarget as HTMLElement;
          const id = target.dataset.storyId;
          const found = allStories.find((item: any) => item.id === id);
          if (found) {
            window.location.href = `/write?type=story&id=${encodeURIComponent(found.id)}&slug=${encodeURIComponent(found.slug || '')}`;
          }
        });
      });

      // Wire delete actions
      feed.querySelectorAll('.delete-story-action').forEach(btn => {
        btn.addEventListener('click', async (e) => {
          const target = e.currentTarget as HTMLElement;
          const id = target.dataset.storyId;
          const title = target.dataset.storyTitle || 'this story';
          const isCustom = target.dataset.isCustom === 'true';
          if (!id) return;

          if (confirm(`Are you sure you want to delete "${title}"? This cannot be undone.`)) {
            try {
              if (isSupabaseConfigured() && !isCustom) {
                await deleteSupabaseStory(id);
              } else {
                const currentCustom = JSON.parse(localStorage.getItem('custom_stories') || '[]');
                const updated = currentCustom.filter((item: any) => item.id !== id);
                localStorage.setItem('custom_stories', JSON.stringify(updated));
              }
              await loadAndRenderStories();
            } catch (err: any) {
              alert('Failed to delete story: ' + (err.message || err));
            }
          }
        });
      });
    }

    function escapeHtml(str: string) {
      return (str || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    categoryTabsContainer?.querySelectorAll('.filter-tab').forEach(tab => {
      tab.addEventListener('click', (e) => {
        categoryTabsContainer.querySelectorAll('.filter-tab').forEach(t => t.classList.remove('active'));
        const target = e.currentTarget as HTMLElement;
        target.classList.add('active');
        currentCategory = target.dataset.cat || 'All';
        filterAndRender();
      });
    });

    searchInput?.addEventListener('input', () => {
      searchQuery = searchInput.value.trim().toLowerCase();
      filterAndRender();
    });

    document.getElementById('reset-filter-btn')?.addEventListener('click', () => {
      currentCategory = 'All';
      searchQuery = '';
      if (searchInput) searchInput.value = '';
      categoryTabsContainer?.querySelectorAll('.filter-tab').forEach((t, i) => {
        if (i === 0) t.classList.add('active');
        else t.classList.remove('active');
      });
      filterAndRender();
    });

    filterAndRender();
  }

  loadAndRenderStories();
  document.addEventListener('astro:after-swap', loadAndRenderStories);
</script>
